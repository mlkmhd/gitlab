- breadcrumb_title s_('DependencyFirewall|Dependency firewall')
- page_title s_('DependencyFirewall|Dependency firewall')
- access_enabled = Security::DependencyFirewall::Availability.access_enabled?(@project)
- dashboard_data = { namespace_type: 'project', full_path: @project.full_path, new_policy_path: new_project_security_policy_path(@project, type: 'dependency_firewall_policy'), disable_new_policy: (!access_enabled || !can_create_or_modify_security_policy?(@project)).to_s, dashboard_v2_enabled: access_enabled.to_s }

#js-dependency-firewall-dashboard{ data: dashboard_data }
